# Modèle de configuration — copier en .env.local et remplir.
# Ne JAMAIS committer de vraie valeur. Seules les variables NEXT_PUBLIC_*
# sont exposées au navigateur : n'y mettez aucun secret.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
# true une fois Stripe configuré (clés, prix, webhook) : ouvre les paiements et l’essai gratuit
NEXT_PUBLIC_STRIPE_ENABLED=
# true une fois Google activé dans Supabase (Authentication → Providers) : bouton « Continuer avec Google »
NEXT_PUBLIC_GOOGLE_AUTH=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ID_FAMILLE=
# Prix annuels : secrets de la fonction Edge create-checkout (supabase secrets set STRIPE_PRICE_ID_PRO_ANNUEL=… STRIPE_PRICE_ID_FAMILLE_ANNUEL=…)

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=
# Statistiques internes (/admin) : adresses email des administrateurs, séparées par des virgules
ADMIN_EMAILS=
# Analyse avec consentement (bannière « Accepter / Refuser ») : laisser vide = aucun de ces outils, aucune bannière
# Google Analytics 4 : identifiant de mesure « G-XXXXXXXXXX » (analytics.google.com → Admin → Flux de données)
NEXT_PUBLIC_GA_ID=
# Amplitude (rétention) : clé API du projet, région UE (analytics.amplitude.com → Settings → Projects)
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Lien du tableau de bord Plausible affiché dans /admin (facultatif)
NEXT_PUBLIC_PLAUSIBLE_URL=

# IA / emails (serveur uniquement)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Médiateur de la consommation (obligation légale) : à choisir dans la liste officielle
# https://www.economie.gouv.fr/mediation-conso/liste-des-mediateurs-references puis à renseigner ici.
NEXT_PUBLIC_MEDIATEUR_NOM=
NEXT_PUBLIC_MEDIATEUR_URL=
NEXT_PUBLIC_MEDIATEUR_ADRESSE=
